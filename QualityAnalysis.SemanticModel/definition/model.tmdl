model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Auditors","Emp Master","Quality Data"]

annotation PBI_ProTooling = ["DevMode"]

ref table Auditors
ref table 'Emp Master'
ref table 'Quality Data'
ref table Calendar

ref cultureInfo en-US

