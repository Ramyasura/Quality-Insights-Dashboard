table 'Quality Data'
	lineageTag: af7efe8a-30a1-4410-9a62-255b2fa4f4ac

	measure 'Sampling Percentage' = DIVIDE(SUM('Quality Data'[Samples]),SUM('Quality Data'[Total Tasks]),BLANK())
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0233b4af-8c5e-44e7-b6b9-9694d710f5cd

	measure 'Quality Score' = IF([Defect Percentage]=BLANK(),BLANK(),1-[Defect Percentage])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6d71a688-73af-416a-b765-31eb59ebe0bc

	measure 'Defect Percentage' = DIVIDE(SUM('Quality Data'[Defects]),SUM('Quality Data'[Samples]),BLANK())
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c3ee3d5d-fa51-4007-89ae-a42e433c3001

	measure 'Fatal error percentage' = DIVIDE(SUM('Quality Data'[Fatal Errors]),SUM('Quality Data'[Samples]),BLANK())
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1c100444-3b81-475b-a756-97461394ea76

